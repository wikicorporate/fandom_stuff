/* @shader: crt-pulse */
void fragment() {
    vec2 uv = UV * 2.0 - 1.0;
    uv.x *= float(ViewSize.x) / float(ViewSize.y);
    float d = length(uv);
    float wave = sin(d * 12.0 - u_time * 3.0) * 0.5 + 0.5;
    float scanline = sin(UV.y * float(ViewSize.y) * 1.5) * 0.12;
    vec3 col = mix(vec3(0.08, 0.04, 0.18), vec3(0.28, 0.75, 0.62), wave / (d * 2.2 + 0.3));
    FOut = vec4(col - scanline, 1.0);
}
