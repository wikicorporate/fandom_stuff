// @template: card
.wiki-haml-card{style: "background:var(--theme-page-background-color--secondary);border:1px solid var(--theme-border-color);border-radius:8px;padding:16px;margin:10px 0;"}
  .wiki-haml-card__header{style: "display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--theme-border-color);padding-bottom:8px;margin-bottom:10px;"}
    %h3{style: "margin:0;color:var(--theme-page-text-color);font-size:1.15rem;"}= title
    %span.wiki-haml-card__badge{style: "background:var(--theme-accent-color);color:#fff;padding:2px 8px;border-radius:999px;font-size:0.75rem;font-weight:600;"}= badge
  .wiki-haml-card__body{style: "color:var(--theme-page-text-color);line-height:1.5;"}
    %p{style: "margin:0;"}= desc

// @template: quote
%blockquote.wiki-haml-quote{style: "background:var(--theme-page-background-color--secondary);border-left:4px solid var(--theme-accent-color);border-radius:0 8px 8px 0;padding:12px 16px;margin:12px 0;"}
  %p.wiki-haml-quote__text{style: "margin:0 0 6px 0;font-style:italic;"}= text
  %footer.wiki-haml-quote__author{style: "font-size:0.85rem;color:var(--theme-page-text-color--secondary);"}= author

// @template: alert
.wiki-haml-alert{style: "background:var(--theme-page-background-color--secondary);border:1px solid var(--theme-accent-color);border-radius:8px;padding:12px 16px;margin:10px 0;"}
  %strong{style: "display:block;margin-bottom:4px;color:var(--theme-accent-color);"}= title
  %span{style: "color:var(--theme-page-text-color);"}= text
